# Secrets and live config. Never commit these.
# (.env.example IS committed; the patterns below carve out everything else.)
.env
.env.test
.env.local
.env.production
config.yaml
config.test.yaml
config.local.yaml

# Local data volume (SQLite, uploads)
data/

# Python bytecode and caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/

# Build artifacts
dist/
*.egg-info/

# macOS metadata
.DS_Store

# Editor/IDE directories
.idea/
.vscode/
